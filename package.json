{
  "name": "reserva-facil",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "pretest": "npm run build",
    "test": "node --test && jest",
    "test:unit": "npm run build && jest",
    "premigration:generate": "npm run build",
    "migration:generate": "typeorm migration:generate -d dist/infrastructure/persistence/typeorm/ormconfig.js",
    "postmigration:generate": "prettier --write src/infrastructure/persistence/typeorm/migrations",
    "premigration:run": "npm run build",
    "migration:run": "typeorm migration:run -d dist/infrastructure/persistence/typeorm/ormconfig.js",
    "premigration:revert": "npm run build",
    "migration:revert": "typeorm migration:revert -d dist/infrastructure/persistence/typeorm/ormconfig.js",
    "lint": "eslint .",
    "format": "prettier --write src test *.mjs *.json",
    "format:check": "prettier --check src test *.mjs *.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "mysql2": "^3.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@jest/globals": "^30.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.5.0",
    "jest": "^30.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
