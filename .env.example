PORT=3000

# MySQL/MariaDB. Copia este archivo a .env (ignorado por Git) y completa DB_PASSWORD; no guardes credenciales reales aquí.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reservafacil
DB_USER=root
DB_PASSWORD=

# JWT. JWT_SECRET es obligatorio (mínimo 32 caracteres); genera uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# JWT_EXPIRES_IN acepta segundos o un sufijo s, m, h o d. 1h es provisional hasta resolver PA-010.
JWT_SECRET=
JWT_EXPIRES_IN=1h
